---
import Default from '@astrojs/starlight/components/Header.astro';
---

<div class="cereal-banner">
  🌐 This complete English translation is maintained and hosted by <a href="https://github.com/The-CerealDev">The-CerealDev</a>.
</div>
<Default {...Astro.props} />

<style>
  .cereal-banner {
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-text-accent);
    text-align: center;
    padding: 0.5rem 1rem;
    font-size: var(--sl-text-sm);
    border-bottom: 1px solid var(--sl-color-hairline);
    font-weight: 500;
  }
  .cereal-banner a {
    color: var(--sl-color-text-accent);
    font-weight: bold;
    text-decoration: underline;
  }
  .cereal-banner a:hover {
    color: var(--sl-color-white);
  }
</style>
